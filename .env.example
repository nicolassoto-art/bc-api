# Copy to .env and fill in. Never commit .env.
# Production values live on the VPS at /opt/bc-api/.env (chmod 600).

# Database
DATABASE_URL=postgresql+psycopg://bcapi:CHANGE_ME@localhost:5432/bcapi

# JWT
JWT_SECRET=CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING
JWT_ALGORITHM=HS256
JWT_TTL_HOURS=24

# Storage
UPLOAD_DIR=/opt/bc-api/uploads
MAX_UPLOAD_MB=10

# CORS — frontends allowed to call the API
CORS_ORIGINS=https://herramientas.bigcapital.cl,http://localhost:8765

# Super admins (comma-separated emails)
SUPER_ADMINS=nicolas.soto@bigcapital.cl

# Environment
ENV=production
LOG_LEVEL=INFO
